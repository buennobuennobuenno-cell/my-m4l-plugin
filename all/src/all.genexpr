// All 2.1.0. Feed-forward attenuation, stereo routing and integer delays only.
// Finite pseudorandom state, not a physical entropy source or a Bernoulli proof.
// No repeat rejection, small-change bias, feedback, waveshaper or audio generator.

all_random(a, b) {
    aa = 40014 * a;
    bb = 40692 * b;
    aa = aa - floor(aa / 2147483563) * 2147483563;
    bb = bb - floor(bb / 2147483399) * 2147483399;
    zz = aa - bb;
    if (zz < 1) { zz = zz + 2147483562; }
    return zz / 2147483563, aa, bb;
}

// Direct equal-width bins. No power law, random walk or favored endpoint.
// Control amplitude resolution is 16 bits, including both 0 and 1.
all_target(u, kind, limit) {
    tt = floor(u * 65536) / 65535;
    if (kind == 1) { tt = floor(u * (limit + 1)); }
    return tt;
}

all_interval(u, maximum) {
    return 1 + floor(u * maximum);
}

// Independent call-site state. Five gain/pan curve families have equal-width bins.
// Gain/pan timing: 1 sample..12 seconds. Delay targets are held for 20 ms..12 s.
// No sample-wise random modulation or continuous sweeping of delay read addresses.
// Repeated targets, durations and shapes are legal; no repeat rejection.
all_motion(seed, tag, initial, kind) {
    History hSeed(-1);
    History hRate(0);
    History hA(1);
    History hB(1);
    History hWait(0);
    History hAge(0);
    History hPeriod(1);
    History hFrom(0);
    History hTo(0);
    History hValue(0);
    History hShape(0);
    History hLevels(2);
    History hCycles(1);
    History hMaximum(1);
    History hLimit(1);

    ma = hA; mb = hB; mwait = hWait; mage = hAge; mperiod = hPeriod;
    mfrom = hFrom; mto = hTo; mvalue = hValue; mshape = hShape;
    mlevels = hLevels; mcycles = hCycles; mseed = hSeed;
    mmaximum = hMaximum; mlimit = hLimit;
    mu = 0; mp = 0; mq = 0;
    if (seed != mseed || samplerate != hRate) {
        ma = 1 + mod(floor(abs(seed) + tag * 104729), 2147483562);
        mb = 1 + mod(floor(abs(seed) * 5 + tag * 13007 + 12345), 2147483398);
        mseed = seed; mwait = 0; mvalue = initial; mfrom = initial; mto = initial;
        mage = 0; mperiod = 1;
        mlimit = min(524287, max(1, floor(samplerate * 2)));
        mmaximum = max(1, floor(samplerate * 12));
    }
    if (mwait <= 0) {
        mfrom = mvalue; mage = 0;
        mu, ma, mb = all_random(ma, mb);
        mshape = floor(mu * 5);
        mu, ma, mb = all_random(ma, mb);
        mwait = all_interval(mu, mmaximum);
        if (kind == 1) {
            mminimum = max(1, floor(samplerate * 0.02));
            mwait = mminimum + floor(mu * (mmaximum - mminimum + 1));
        }
        mu, ma, mb = all_random(ma, mb);
        mperiod = all_interval(mu, mmaximum);
        mu, ma, mb = all_random(ma, mb);
        mto = all_target(mu, kind, mlimit);
        mu, ma, mb = all_random(ma, mb);
        mlevels = 2 + floor(mu * 31);
        mu, ma, mb = all_random(ma, mb);
        mcycles = 1 + floor(mu * 8);
    }
    // Delay resolution remains one sample, but its target is held between events.
    // Changing arbitrary read addresses every sample resampled input into noise.
    if (kind == 1) { mshape = 0; }
    mage = min(mperiod, mage + 1);
    mp = mage / mperiod;
    mvalue = mto;
    // 0: hard/hold; 1: linear; 2: smooth; 3: stairs; 4: triangle.
    if (mshape == 1) { mvalue = mfrom + (mto - mfrom) * mp; }
    else if (mshape == 2) { mvalue = mfrom + (mto - mfrom) * mp * mp * (3 - 2 * mp); }
    else if (mshape == 3) {
        mq = floor(mp * mlevels) / mlevels;
        mvalue = mfrom + (mto - mfrom) * mq;
    } else if (mshape == 4) {
        mq = mp * mcycles;
        mq = mq - floor(mq);
        mvalue = mfrom + (mto - mfrom) * (1 - abs(2 * mq - 1));
        if (mage >= mperiod) { mage = 0; }
    }
    hSeed = mseed; hA = ma; hB = mb; hWait = mwait - 1;
    hAge = mage; hPeriod = mperiod; hFrom = mfrom; hTo = mto;
    hValue = mvalue; hShape = mshape; hLevels = mlevels; hCycles = mcycles;
    hMaximum = mmaximum; hLimit = mlimit; hRate = samplerate;
    return mvalue;
}

// One input-only stereo ring, 8 MiB at double precision. No processed audio returns.
Data allRaw(524288, 2);
History hWrite(0);
History hAvailable(0);
History hRate(0);

// Invalid/absurd inputs are discarded before storage, not waveshaped or limited.
xL = 0; xR = 0; wet = 0; seed = 13579;
if (abs(in1) <= 64) { xL = in1; }
if (abs(in2) <= 64) { xR = in2; }
if (in3 >= 0 && in3 <= 1) { wet = in3; }
if (in4 >= 1 && in4 <= 2147483000) { seed = floor(in4); }

gainL = clamp(all_motion(seed, 1, 1, 0), 0, 1);
gainR = clamp(all_motion(seed, 2, 1, 0), 0, 1);
panL = clamp(all_motion(seed, 3, 0, 0), 0, 1);
panR = clamp(all_motion(seed, 4, 1, 0), 0, 1);
delayL = all_motion(seed, 5, 0, 1);
delayR = all_motion(seed, 6, 0, 1);

writePos = hWrite; available = hAvailable;
// Retire history on a rate change without clearing/reallocating in the audio loop.
if (samplerate != hRate) { writePos = 0; available = 0; }
delayLimit = min(524287, max(1, floor(samplerate * 2)));
dL = clamp(floor(delayL + 0.5), 0, delayLimit);
dR = clamp(floor(delayR + 0.5), 0, delayLimit);
readL = writePos - dL; readR = writePos - dR;
if (readL < 0) { readL = readL + 524288; }
if (readR < 0) { readR = readR + 524288; }

// Each output reads both input channels at its own time, then distributes them.
// Thus a left-only source can reach either output at independent delay times.
tapLL = 0; tapLR = 0; tapRL = 0; tapRR = 0;
if (dL == 0) { tapLL = xL; tapLR = xR; }
else if (dL <= available) {
    tapLL = peek(allRaw, readL, 0);
    tapLR = peek(allRaw, readL, 1);
}
if (dR == 0) { tapRL = xL; tapRR = xR; }
else if (dR <= available) {
    tapRL = peek(allRaw, readR, 0);
    tapRR = peek(allRaw, readR, 1);
}

// Nonnegative row sums <= 1: no internal amplification, polarity flip or limiter.
aLL = gainL * (1 - panL); aLR = gainL * panL;
aRL = gainR * (1 - panR); aRR = gainR * panR;
wetL = aLL * tapLL + aLR * tapLR;
wetR = aRL * tapRL + aRR * tapRR;

// Convex Dry/Wet also preserves the input-history peak bound.
out1 = (1 - wet) * xL + wet * wetL;
out2 = (1 - wet) * xR + wet * wetR;
poke(allRaw, xL, writePos, 0);
poke(allRaw, xR, writePos, 1);
hWrite = writePos + 1;
if (writePos >= 524287) { hWrite = 0; }
hAvailable = min(524287, available + 1);
hRate = samplerate;
